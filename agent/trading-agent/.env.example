# ── Chế độ chạy ──────────────────────────────────────────────
# paper   : tiền ảo, không cần API key (mặc định)
# testnet : sàn thử Binance Spot Testnet (key tạo tại https://testnet.binance.vision)
# live    : TIỀN THẬT. Bắt buộc thêm LIVE_CONFIRM bên dưới.
MODE=paper
# Chỉ khi MODE=live, phải ghi đúng: I_ACCEPT_REAL_MONEY_RISK
LIVE_CONFIRM=

# ── Binance (testnet hoặc live). Key live: chỉ bật quyền Spot Trading, TẮT quyền rút tiền, giới hạn IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Telegram: tạo bot với @BotFather, lấy chat id bằng @userinfobot
TELEGRAM_BOT_TOKEN=
# Chat id RIÊNG với bot (số dương). Lệnh từ nhóm chat bị từ chối.
TELEGRAM_CHAT_ID=
# (Tuỳ chọn) chỉ nhận lệnh từ các user id này, cách nhau bởi dấu phẩy. Bỏ trống = chủ của chat id ở trên.
TELEGRAM_ALLOWED_USER_IDS=

# ── Claude (nhận xét tín hiệu). Bỏ trống thì tắt phần nhận xét.
ANTHROPIC_API_KEY=
